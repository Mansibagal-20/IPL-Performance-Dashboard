      <aliases enabled='yes' />
      <column caption='Total Balls' datatype='integer' name='[Calculation_1144373790212097]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([ball])' />
      </column>
      <column caption='Total Matches' datatype='integer' name='[Calculation_1144373790314498]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([match_id])' />
      </column>
      <column caption='Total Wickets' datatype='integer' name='[Calculation_1144373790429187]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;IF [dismissal_kind] != &quot;NA&quot; THEN 1 ELSE 0 END&#10;)' />
      </column>
      <column caption='Strike Rate' datatype='real' name='[Calculation_1144373790502916]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([batsman_runs]) / COUNT([ball])) * 100' />
      </column>
      <column caption='Batting Average' datatype='real' name='[Calculation_1144373790580741]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([batsman_runs]) /&#10;SUM(&#10;IF [dismissal_kind] != &quot;NA&quot; THEN 1 ELSE 0 END&#10;)' />
      </column>
      <column caption='Boundary Runs' datatype='integer' name='[Calculation_1144373790662662]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;IF [batsman_runs] = 4 OR [batsman_runs] = 6&#10;THEN [batsman_runs]&#10;ELSE 0&#10;END&#10;)' />
      </column>
      <column caption='Boundary %' datatype='real' name='[Calculation_1144373790760967]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1144373790662662] / SUM([batsman_runs]) * 100' />
      </column>
      <column caption='Economy Rate (Bowling)' datatype='real' name='[Calculation_1144373790842888]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_runs]) / (COUNT([ball]) / 6)' />
      </column>
      <column caption='Toss Win %' datatype='real' name='[Calculation_1144373790933001]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;IF [toss_winner] = [winner] THEN 1 ELSE 0 END&#10;)&#10;/&#10;COUNT([match_id])' />
      </column>
